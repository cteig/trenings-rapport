generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             Int      @id @default(autoincrement())
  stravaId       Int      @unique
  firstName      String   @default("")
  accessToken    String
  refreshToken   String
  tokenExpiresAt Int
  activities     String?
  activitiesCachedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
